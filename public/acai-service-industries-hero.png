<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#16213e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f3460;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#ff1a1a;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#a100ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#004cff;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  
  <!-- Grid pattern -->
  <g opacity="0.1">
    <path d="M0 0 L1200 0 L1200 630 L0 630 Z" stroke="url(#accent)" stroke-width="1" fill="none" stroke-dasharray="20,10"/>
  </g>
  
  <!-- Service Industry Icons -->
  <!-- Car (Auto Detailing) -->
  <g transform="translate(150, 200)">
    <rect x="0" y="20" width="80" height="40" rx="5" fill="url(#accent)" opacity="0.3"/>
    <circle cx="20" cy="65" r="12" fill="#fff" opacity="0.6"/>
    <circle cx="60" cy="65" r="12" fill="#fff" opacity="0.6"/>
    <text x="40" y="100" font-family="Arial, sans-serif" font-size="12" fill="#fff" text-anchor="middle">Auto Detailing</text>
  </g>
  
  <!-- Scissors (Barber/Salon) -->
  <g transform="translate(400, 200)">
    <circle cx="30" cy="30" r="15" fill="url(#accent)" opacity="0.3"/>
    <circle cx="50" cy="50" r="15" fill="url(#accent)" opacity="0.3"/>
    <line x1="30" y1="30" x2="50" y2="50" stroke="#fff" stroke-width="3" opacity="0.6"/>
    <text x="40" y="100" font-family="Arial, sans-serif" font-size="12" fill="#fff" text-anchor="middle">Barber/Salon</text>
  </g>
  
  <!-- Spray bottle (Cleaning) -->
  <g transform="translate(650, 200)">
    <rect x="30" y="10" width="20" height="15" fill="url(#accent)" opacity="0.3"/>
    <path d="M35 25 L45 25 L50 70 L30 70 Z" fill="url(#accent)" opacity="0.6"/>
    <text x="40" y="100" font-family="Arial, sans-serif" font-size="12" fill="#fff" text-anchor="middle">Cleaning</text>
  </g>
  
  <!-- Wrench (Plumbing/HVAC) -->
  <g transform="translate(900, 200)">
    <rect x="20" y="30" width="40" height="10" rx="5" fill="url(#accent)" opacity="0.3" transform="rotate(-45 40 35)"/>
    <circle cx="25" cy="35" r="8" fill="#fff" opacity="0.6"/>
    <text x="40" y="100" font-family="Arial, sans-serif" font-size="12" fill="#fff" text-anchor="middle">Plumbing/HVAC</text>
  </g>
  
  <!-- Main Title -->
  <text x="600" y="400" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#fff" text-anchor="middle">
    Powering Service Businesses
  </text>
  <text x="600" y="450" font-family="Arial, sans-serif" font-size="36" fill="#fff" text-anchor="middle" opacity="0.8">
    Across Every Industry
  </text>
  
  <!-- Mica Growth Branding -->
  <g transform="translate(500, 520)">
    <rect width="200" height="60" rx="30" fill="url(#accent)" opacity="0.2"/>
    <text x="100" y="40" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#fff" text-anchor="middle">
      Mica Growth
    </text>
  </g>
  
  <!-- Decorative elements -->
  <circle cx="100" cy="100" r="5" fill="url(#accent)" opacity="0.5">
    <animate attributeName="opacity" values="0.3;0.8;0.3" dur="3s" repeatCount="indefinite"/>
  </circle>
  <circle cx="1100" cy="500" r="7" fill="url(#accent)" opacity="0.5">
    <animate attributeName="opacity" values="0.5;1;0.5" dur="2s" repeatCount="indefinite"/>
  </circle>
</svg>